# Copy to .env.local and fill in. Never commit .env.local.

# App
BETTER_AUTH_URL=http://localhost:3001
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# MongoDB Atlas (free M0). Include the database name in the path.
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/pharmabharat?retryWrites=true&w=majority
# Optional; defaults to "pharmabharat"
MONGODB_DB=pharmabharat

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become platform admins on first sign-in
ADMIN_EMAILS=

# Cloudinary (KYC documents are uploaded as "authenticated" = not publicly reachable)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Gmail SMTP (use a Google "App password", not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PharmaBharat <no-reply@example.com>"

# Daily jobs (near-expiry alerts). Any long random string; the scheduler sends it
# as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily
CRON_SECRET=

# Realtime chat (realtime/ service). Leave empty to use polling only.
# Browser-reachable URL of the realtime service, and a shared secret (same value in realtime/.env)
REALTIME_URL=http://localhost:4000
REALTIME_SECRET=

# Public support contact shown on the /help page (optional)
SUPPORT_EMAIL=
